# ==============================================================================
# Project AURA — Environment Variables & AWS Bedrock Configuration
# ==============================================================================
# Duplicate this file as '.env' and fill in your actual AWS credentials.
# NOTE: Never commit your real '.env' file to GitHub.

# --- AWS Credentials (from IAM Console) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# --- AWS Bedrock Model Configuration ---
# Default model: Claude 3.5 Sonnet v2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Toggle between live AWS Bedrock calls and offline test simulation
# Set to 'false' to use your real AWS Bedrock credits; set to 'true' for offline mock
BEDROCK_MOCK=false

# --- Optional DynamoDB & WebSocket (if deploying cloud intake) ---
# AURA_TABLE_NAME=aura-production-context
# AURA_WS_ENDPOINT=wss://your-api-id.execute-api.us-east-1.amazonaws.com/prod
