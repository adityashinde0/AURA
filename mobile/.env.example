# ==============================================================================
# AURA Mobile — Environment Variables
# ==============================================================================
# Copy this file to .env in mobile/ to point the app to your live backend.

# 1. Cloud REST API Gateway base URL
EXPO_PUBLIC_API_BASE=https://api.aura.internal/v1

# 2. Cloud WebSocket API Gateway endpoint (from AWS API Gateway)
EXPO_PUBLIC_WS_URL=wss://ws.aura.internal/v1

# 3. Optional Enterprise OAuth / Cognito Configuration
EXPO_PUBLIC_OAUTH_ISSUER=https://auth.aura.internal
EXPO_PUBLIC_OAUTH_CLIENT_ID=aura-mobile-client
