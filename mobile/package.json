{
  "name": "aura-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^14.0.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.0",
    "expo-auth-session": "^5.5.2",
    "expo-crypto": "^13.0.2",
    "expo-haptics": "^13.0.1",
    "expo-notifications": "^0.28.9",
    "expo-secure-store": "^13.0.2",
    "expo-status-bar": "~1.12.1",
    "metro": "^0.80.8",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-ble-plx": "^3.2.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^26.6.4",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.4.5"
  },
  "expo": {
    "name": "AURA",
    "slug": "aura-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aura.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "AURA uses Bluetooth to communicate with your Orbit wearable.",
        "NSBluetoothPeripheralUsageDescription": "AURA uses Bluetooth to communicate with your Orbit wearable."
      }
    },
    "android": {
      "package": "com.aura.mobile",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "AURA uses Bluetooth to communicate with your Orbit wearable."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
